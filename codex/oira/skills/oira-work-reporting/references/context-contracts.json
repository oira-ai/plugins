            "user_uuid",
            "organization_uuid",
            "project_uuid",
            "connection_uuid",
            "resource_authority_uuid",
            "resource_epoch",
            "grant_uuid",
            "grant_generation",
            "mapping_revision"
          ],
          "title": "CodingTargetV1",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "binding_generation": {
          "description": "The generation returned with that same session binding.",
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Binding Generation",
          "type": "integer"
        },
        "delivery_ref": {
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Delivery Ref",
          "type": "string"
        },
        "expected_revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "expected_target": {
          "$ref": "#/$defs/CodingTargetV1",
          "description": "Copy the complete explicitly approved target object unchanged from connection status; never reconstruct its UUIDs."
        },
        "format": {
          "const": "oira.context_intervention_ack.v1",
          "default": "oira.context_intervention_ack.v1",
          "title": "Format",
          "type": "string"
