  "tools": {
    "oira_ack_context_intervention": {
      "description": "Acknowledge what this agent observed or did with a scoped Oira intervention. Never claim a native boundary hold or that acknowledgment resolves the underlying conflict.",
      "request_schema": "AgentContextAckV1"
    },
    "oira_bind_context_session": {
      "description": "Bind this coding chat to its explicitly approved exact company/project before asking Oira for context. Requires separate context-read or intervention consent; grants no new access.",
      "request_schema": "AgentContextSessionBindV1"
    },
    "oira_cancel_context_check": {
      "description": "Cancel the exact Oira context check and generation. Does not resolve or clear an independent conflict blocking the tracked operation.",
      "request_schema": "AgentContextCancelV1"
    },
    "oira_check_context": {
      "description": "Ask Oira a bounded question composed for company DNA, accepted decisions, constraints or related work before planning or a consequential milestone. Supply the approved target/binding, question, assumptions and next step; optionally use an existing reporting work_handle. Returns a durable background check, never an immediate approval. Poll that same check using poll_after_ms. Set include_discussion_refs=true in submit/status for the expanded answer and visible private discussion references. Separate context-read consent required. Never attach transcripts, files or credentials.",
      "request_schema": "AgentContextCheckRequestV1"
    },
    "oira_context_check_status": {
      "description": "Read progress and the evidence-backed result of an existing Oira company-context check without starting new reasoning. Only a current released result is usable; respect missing coverage, conflicts and the returned poll delay.",
      "request_schema": "AgentContextStatusV1"
    },
    "oira_context_interventions": {
      "description": "Read scoped conflict and recheck notices for this bound operation after separate intervention consent. A notice is advisory and does not prove native execution stopped.",
      "request_schema": "AgentContextInterventionsPageV1"
    },
    "oira_revoke_context_session": {
      "description": "Revoke the exact logical Oira context binding. Does not stop a native process or clear an unresolved operation conflict.",
      "request_schema": "AgentContextRevokeBindingV1"
    }
  }
