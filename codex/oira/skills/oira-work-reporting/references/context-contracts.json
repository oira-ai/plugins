          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Binding Ref",
          "type": "string"
        }
      },
      "required": [
        "expected_target",
        "session_binding_ref",
        "binding_generation",
        "delivery_ref",
        "expected_revision",
        "observed_state",
        "adapter_id",
        "adapter_version"
      ],
