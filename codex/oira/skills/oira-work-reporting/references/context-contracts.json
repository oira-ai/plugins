          "type": "string"
        },
        "include_discussion_refs": {
          "default": false,
          "title": "Include Discussion Refs",
          "type": "boolean"
        },
        "intent_revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Intent Revision",
          "type": "integer"
        },
        "next_step": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The immediate action or decision that depends on this answer. Include it for new checks and rechecks so Oira can identify consequential gaps.",
          "title": "Next Step"
        },
        "operation_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Operation Ref",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "change_consistency",
            "governing_context",
            "prior_decisions",
            "work_continuation"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "question": {
          "description": "A focused question stating the intended outcome and relevant scope; put uncertain premises and the next decision in their separate fields too.",
          "maxLength": 12000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "session_binding_ref": {
          "description": "The exact session_binding_ref returned by the successful context binding, including on status calls and rechecks.",
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Binding Ref",
          "type": "string"
        },
        "wait_ms": {
          "default": 0,
          "maximum": 1500,
          "minimum": 0,
          "title": "Wait Ms",
          "type": "integer"
        },
        "work_handle": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^wh_[a-zA-Z0-9_-]{1,29}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Handle"
        }
      },
      "required": [
        "expected_target",
        "session_binding_ref",
        "binding_generation",
        "client_request_ref",
        "operation_ref",
        "intent_revision",
        "question",
        "purpose"
      ],
