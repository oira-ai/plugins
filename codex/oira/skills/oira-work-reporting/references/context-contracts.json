            "maxLength": 255,
            "minLength": 1,
            "pattern": "^(record|domain|subject|artifact):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
